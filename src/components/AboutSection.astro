---

---

<section
	class="about-section"
	data-about-section
	aria-labelledby="about-title"
>
	<h2 id="about-title" class="about-title" data-about-title>About Me</h2>
	<div class="about-card" data-ice-panel>
		<picture class="ice-art-picture" data-ice-art>
			<source
				srcset="/illustrations/space/ice-frame.avif"
				type="image/avif"
			/>
			<img
				class="ice-art"
				src="/illustrations/space/ice-frame.png"
				width="1536"
				height="1024"
				alt=""
				loading="lazy"
				decoding="async"
			/>
		</picture>
		<span class="ice-shine" data-ice-shine aria-hidden="true"></span>
		<div class="about-content">
			I'm a passionate software engineer with a focus on AI. I'm currently a
			3B{" "}<a
				class="webring-link"
				href="https://se-webring.xyz/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Software Engineering student at the University of Waterloo
			</a>.
			The unknown piques my interest and I'm always eager to learn new things. In
			my free time, I keep up with the latest AI research, often reading papers
			on arXiv. Outside of academics, I like cooking, traveling, working out at
			the gym, and playing ultimate frisbee. I'm always looking for opportunities
			to learn and grow, so feel free to reach out—I'm happy to connect!
		</div>
	</div>
</section>

<style>
	.about-section {
		position: relative;
		z-index: 3;
		display: flex;
		min-height: 86vh;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(5rem, 10vw, 9rem) 1rem;
		perspective: 1000px;
	}

	.about-title {
		margin: 0 0 clamp(1.2rem, 3vw, 2.25rem);
		color: var(--space-text-primary, #f7fbff);
		font-family: "Sora", sans-serif;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1;
		text-align: center;
		text-shadow: 0 0 32px rgba(66, 168, 255, 0.18);
		will-change: transform, opacity;
	}

	.about-title::after {
		display: block;
		width: 2.8rem;
		height: 0.16rem;
		margin: 0.65rem auto 0;
		border-radius: 999px;
		background: var(--space-ice-cyan, #62dcff);
		box-shadow: 0 0 14px rgba(98, 220, 255, 0.5);
		content: "";
	}

	.about-card {
		position: relative;
		display: grid;
		width: min(94vw, 860px);
		aspect-ratio: 3 / 2;
		overflow: hidden;
		place-items: center;
		transform-style: preserve-3d;
		transform-origin: 50% 50%;
		will-change: transform, opacity;
	}

	.ice-art-picture,
	.ice-shine,
	.about-content {
		grid-area: 1 / 1;
	}

	.ice-art-picture {
		position: relative;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		user-select: none;
	}

	.ice-art {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: fill;
	}

	.ice-shine {
		position: relative;
		z-index: 1;
		width: 24%;
		height: 58%;
		justify-self: start;
		background: linear-gradient(
			105deg,
			transparent 12%,
			rgba(247, 251, 255, 0.12) 34%,
			rgba(247, 251, 255, 0.78) 50%,
			rgba(98, 220, 255, 0.16) 67%,
			transparent 88%
		);
		clip-path: polygon(22% 0, 100% 8%, 72% 100%, 0 92%);
		filter: blur(3px);
		mix-blend-mode: screen;
		opacity: 0;
		pointer-events: none;
		will-change: transform, opacity;
	}

	.about-content {
		position: relative;
		z-index: 2;
		width: min(67%, 62ch);
		max-width: 62ch;
		padding: 0.75rem;
		color: #07102d;
		font-family: "Montserrat", sans-serif;
		font-size: clamp(0.9rem, 1.2vw, 1.05rem);
		font-weight: 600;
		line-height: 1.55;
		text-align: left;
		text-shadow: 0 1px 0 rgba(247, 251, 255, 0.46);
	}

	.webring-link {
		border-radius: 0.15em;
		color: #211351;
		font-weight: 700;
		text-decoration-color: rgba(53, 40, 95, 0.64);
		text-decoration-line: underline;
		text-decoration-style: dotted;
		text-decoration-thickness: 0.1em;
		text-underline-offset: 0.18em;
		transition:
			color 180ms ease,
			background-color 180ms ease;
	}

	.webring-link:hover {
		color: #5428bc;
	}

	.webring-link:focus-visible {
		outline: 2px solid #211351;
		outline-offset: 3px;
		background: rgba(247, 251, 255, 0.34);
		color: #5428bc;
	}

	@media (max-width: 639px) {
		.about-section {
			padding-inline: 0.5rem;
		}

		.about-title {
			font-size: clamp(2.35rem, 12vw, 3rem);
		}

		.about-card {
			aspect-ratio: 2 / 3;
		}

		.ice-art-picture {
			width: 150%;
			max-width: none;
			height: auto;
			transform: rotate(90deg);
		}

		.ice-art {
			height: auto;
			object-fit: contain;
		}

		.about-content {
			width: 64%;
			padding: 0.25rem;
			font-size: clamp(0.72rem, 3.1vw, 0.8rem);
			line-height: 1.4;
		}

		.ice-shine {
			height: 70%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-card,
		.about-title,
		.ice-shine {
			will-change: auto;
		}

		.ice-shine {
			display: none;
		}
	}
</style>

<script>
	import { loadGsap } from "../lib/gsapClient";
	import { shouldTeardownOnPageHide } from "../lib/pageLifecycle";
	import { getSpaceMotionProfile } from "../lib/spaceMotion";

	const root = document.querySelector<HTMLElement>("[data-about-section]");

	if (root) {
		let active = true;
		let cleanup = () => {};

		const onPageHide = (event: PageTransitionEvent) => {
			if (!shouldTeardownOnPageHide(event.persisted)) return;
			active = false;
			cleanup();
		};

		window.addEventListener("pagehide", onPageHide);

		void document.fonts.ready.then(async () => {
			if (!active) return;

			const { gsap } = await loadGsap();
			if (!active) return;

			const panel = root.querySelector<HTMLElement>("[data-ice-panel]");
			const reduce = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const profile = getSpaceMotionProfile({
				reducedMotion: reduce,
				viewportWidth: window.innerWidth,
			});

			const context = gsap.context(() => {
				if (profile.mode === "reduced") {
					gsap.set("[data-about-title], [data-ice-panel]", {
						clearProps: "all",
						autoAlpha: 1,
					});
					gsap.set("[data-ice-shine]", { autoAlpha: 0 });
					return;
				}

				const entrance = gsap.timeline({
					defaults: { ease: "power3.out" },
					scrollTrigger: {
						trigger: root,
						start: "top 82%",
						once: true,
					},
				});

				entrance
					.from("[data-about-title]", {
						y: 30,
						autoAlpha: 0,
						duration: 0.58,
					})
					.from(
						"[data-ice-panel]",
						{
							y: 46,
							rotationX: 8,
							scale: 0.94,
							autoAlpha: 0,
							duration: 0.88,
						},
						"-=0.26",
					)
					.fromTo(
						"[data-ice-shine]",
						{ xPercent: -150, autoAlpha: 0 },
						{
							xPercent: 420,
							autoAlpha: 0.62,
							duration: 1.05,
							ease: "power2.inOut",
						},
						"-=0.32",
					)
					.to("[data-ice-shine]", {
						autoAlpha: 0,
						duration: 0.12,
					});
			}, root);

			const media = gsap.matchMedia();
			const body = document.body;
			const enableCursor = () => body.classList.add("cursor-visible");
			const disableCursor = () => body.classList.remove("cursor-visible");

			root.addEventListener("pointerenter", enableCursor);
			root.addEventListener("pointerleave", disableCursor);
			root.addEventListener("focusin", enableCursor);
			root.addEventListener("focusout", disableCursor);

			if (panel) {
				media.add(
					"(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
					() => {
						gsap.set(panel, {
							transformPerspective: 900,
							transformOrigin: "50% 50%",
						});

						const rotationXTo = gsap.quickTo(panel, "rotationX", {
							duration: 0.45,
							ease: "power3.out",
						});
						const rotationYTo = gsap.quickTo(panel, "rotationY", {
							duration: 0.45,
							ease: "power3.out",
						});
						const xTo = gsap.quickTo(panel, "x", {
							duration: 0.45,
							ease: "power3.out",
						});
						const yTo = gsap.quickTo(panel, "y", {
							duration: 0.45,
							ease: "power3.out",
						});

						const reset = () => {
							rotationXTo(0);
							rotationYTo(0);
							xTo(0);
							yTo(0);
						};

						const onPointerMove = (event: PointerEvent) => {
							const bounds = panel.getBoundingClientRect();
							const normalizedX =
								((event.clientX - bounds.left) / bounds.width) * 2 - 1;
							const normalizedY =
								((event.clientY - bounds.top) / bounds.height) * 2 - 1;

							rotationXTo(-normalizedY * profile.tiltDegrees);
							rotationYTo(normalizedX * profile.tiltDegrees);
							xTo(normalizedX * 8);
							yTo(normalizedY * 8);
						};

						panel.addEventListener("pointermove", onPointerMove);
						panel.addEventListener("pointerleave", reset);

						return () => {
							panel.removeEventListener("pointermove", onPointerMove);
							panel.removeEventListener("pointerleave", reset);
							reset();
						};
					},
					root,
				);
			}

			if (!active) {
				media.revert();
				context.revert();
				body.classList.remove("cursor-visible");
				return;
			}

			cleanup = () => {
				root.removeEventListener("pointerenter", enableCursor);
				root.removeEventListener("pointerleave", disableCursor);
				root.removeEventListener("focusin", enableCursor);
				root.removeEventListener("focusout", disableCursor);
				body.classList.remove("cursor-visible");
				media.revert();
				context.revert();
			};
		});
	}
</script>
