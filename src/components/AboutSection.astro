---
import AboutBio from "./AboutBio.astro";
---

<section
	class="about-section"
	data-about-section
	aria-labelledby="about-title"
>
	<h2 id="about-title" class="about-title" data-about-title>About Me</h2>
	<div class="about-card" data-ice-panel>
		<picture class="ice-art-picture" data-ice-art>
			<source
				srcset="/illustrations/space/ice-frame.avif"
				type="image/avif"
			/>
			<img
				class="ice-art"
				src="/illustrations/space/ice-frame.png"
				width="1536"
				height="1024"
				alt=""
				loading="lazy"
				decoding="async"
			/>
		</picture>
		<div class="ice-shine-viewport" aria-hidden="true">
			<div class="ice-shine-mask">
				<div class="ice-shine-plane">
					<span class="ice-shine" data-ice-shine></span>
				</div>
			</div>
		</div>
		<button class="about-intro" type="button" aria-haspopup="dialog" aria-controls="about-dialog">
			<span class="intro-title">Software Engineer</span>
			<span class="intro-school">University of Waterloo</span>
			<span class="intro-action">Read more</span>
		</button>
		<div class="about-content">
			<span class="ice-flow-edge ice-flow-edge--left" aria-hidden="true"></span>
			<span class="ice-flow-edge ice-flow-edge--right" aria-hidden="true"></span>
			<p class="about-copy">
				<AboutBio />
			</p>
		</div>
	</div>
</section>

<dialog id="about-dialog" class="experience-modal-overlay" aria-labelledby="about-dialog-title">
	<div class="experience-modal">
		<form method="dialog">
			<button class="modal__close" aria-label="Close about details" autofocus>
				<span aria-hidden="true">×</span>
			</button>
		</form>
		<header class="modal__header">
			<h2 class="modal__title" id="about-dialog-title">About Me</h2>
		</header>
		<p class="modal__description dialog-copy"><AboutBio /></p>
	</div>
</dialog>

<style>
	.about-section {
		position: relative;
		z-index: 3;
		display: flex;
		min-height: 86vh;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(5rem, 10vw, 9rem) 1rem;
		perspective: 1000px;
	}

	.about-title {
		margin: 0 0 clamp(1.2rem, 3vw, 2.25rem);
		color: var(--space-text-primary, #f7fbff);
		font-family: "Sora", sans-serif;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1;
		text-align: center;
		text-shadow: 0 0 32px rgba(66, 168, 255, 0.18);
		will-change: transform, opacity;
	}

	.about-title::after {
		display: block;
		width: 2.8rem;
		height: 0.16rem;
		margin: 0.65rem auto 0;
		border-radius: 999px;
		background: var(--space-ice-cyan, #62dcff);
		box-shadow: 0 0 14px rgba(98, 220, 255, 0.5);
		content: "";
	}

	.about-card {
		position: relative;
		display: block;
		width: min(94vw, 860px);
		container-type: inline-size;
		overflow: hidden;
		transform-style: preserve-3d;
		transform-origin: 50% 50%;
		will-change: transform, opacity;
	}

	.ice-art-picture {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		user-select: none;
	}

	.ice-art {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: fill;
	}

	.ice-shine-viewport {
		position: absolute;
		z-index: 1;
		inset: 0;
		container-type: size;
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.ice-shine-mask {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/* Keep the artwork boundary fixed while only the inner light sweeps. */
		-webkit-mask: url("/illustrations/space/ice-frame.png") center / 100% 100% no-repeat;
		mask: url("/illustrations/space/ice-frame.png") center / 100% 100% no-repeat;
		mask-image: image-set(
			url("/illustrations/space/ice-frame.avif") type("image/avif"),
			url("/illustrations/space/ice-frame.png") type("image/png")
		);
		mask-mode: alpha;
	}

	.ice-shine-plane {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
	}

	.ice-shine {
		position: relative;
		z-index: 1;
		width: 24%;
		height: 58%;
		justify-self: start;
		background: linear-gradient(
			105deg,
			transparent 12%,
			rgba(247, 251, 255, 0.12) 34%,
			rgba(247, 251, 255, 0.78) 50%,
			rgba(98, 220, 255, 0.16) 67%,
			transparent 88%
		);
		clip-path: polygon(22% 0, 100% 8%, 72% 100%, 0 92%);
		filter: blur(3px);
		opacity: 0;
		pointer-events: none;
		will-change: transform, opacity;
	}

	.about-content {
		/* Preserve the original 3:2 ice at desktop size; reserve more vertical
		   room as readable text wraps on narrower screens or uses larger fonts. */
		--ice-flow-height: max(66.667cqw, calc(105em - 124cqw));
		position: relative;
		z-index: 2;
		display: flow-root;
		width: 100%;
		height: var(--ice-flow-height);
		color: #07102d;
		font-family: "Montserrat", sans-serif;
		font-size: clamp(0.875rem, 1.8cqw, 1rem);
		font-weight: 600;
		line-height: 1.5;
		text-align: left;
		text-shadow: 0 1px 0 rgba(247, 251, 255, 0.46);
	}

	.about-copy {
		margin: 0;
		padding-top: calc(var(--ice-flow-height) * 0.29);
		text-wrap: pretty;
		overflow-wrap: anywhere;
	}

	/* Invisible floats reserve the bevels so native text, selection, and links
	   flow between the contours. Coordinates follow the unrotated flat face. */
	.ice-flow-edge {
		width: 50%;
		height: 100%;
		shape-margin: 0.65em;
		pointer-events: none;
		user-select: none;
	}

	.ice-flow-edge--left {
		float: left;
		shape-outside: polygon(0 0, 44% 0, 44% 26%, 38% 45%, 56% 69%, 70% 77%, 100% 85%, 100% 100%, 0 100%);
	}

	.ice-flow-edge--right {
		float: right;
		shape-outside: polygon(44% 0, 100% 0, 100% 100%, 0 100%, 0 85%, 20% 77%, 34% 69%, 60% 48%, 44% 29%);
	}

	.about-intro {
		display: none;
	}

	.dialog-copy :global(.webring-link) {
		color: #62dcff;
		text-decoration-color: currentColor;
	}

	.dialog-copy :global(.webring-link:focus-visible) {
		outline: 2px solid #62dcff;
		outline-offset: 4px;
	}

	@media (max-width: 639px) {
		.about-section {
			min-height: auto;
			padding: 4rem 0.5rem;
		}

		.about-title {
			font-size: clamp(2.35rem, 12vw, 3rem);
		}

		.about-content {
			display: none;
		}

		.about-intro {
			position: relative;
			z-index: 2;
			display: flex;
			width: 100%;
			min-height: 66.667cqw;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			padding: 20% 19% 22%;
			border: 0;
			background: transparent;
			color: #07102d;
			font-family: "Montserrat", sans-serif;
			text-align: center;
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
		}

		.intro-title {
			font-size: clamp(1rem, 4.5cqw, 1.6rem);
			font-weight: 700;
			line-height: 1.35;
		}

		.intro-school {
			font-size: max(0.75rem, 3.2cqw);
			font-weight: 600;
			line-height: 1.4;
		}

		.intro-action {
			margin-top: 0.2rem;
			font-size: 0.75rem;
			font-weight: 600;
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		.about-intro:focus-visible {
			outline: 2px solid #07102d;
			outline-offset: -3rem;
			border-radius: 35%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-card,
		.about-title,
		.ice-shine {
			will-change: auto;
		}

		.ice-shine {
			display: none;
		}
	}
</style>

<script>
	import { loadGsap } from "../lib/gsapClient";
	import { shouldTeardownOnPageHide } from "../lib/pageLifecycle";
	import { getSpaceMotionProfile } from "../lib/spaceMotion";

	const root = document.querySelector<HTMLElement>("[data-about-section]");

	if (root) {
		const trigger = root.querySelector<HTMLButtonElement>(".about-intro");
		const dialog = document.querySelector<HTMLDialogElement>("#about-dialog");
		const mobile = window.matchMedia("(max-width: 639px)");
		let previousOverflow = "";
		const openBio = () => {
			if (!dialog || dialog.open || !mobile.matches) return;
			previousOverflow = document.documentElement.style.overflow;
			dialog.showModal();
			document.documentElement.style.overflow = "hidden";
		};
		const restoreScroll = () => {
			document.documentElement.style.overflow = previousOverflow;
		};
		const closeOnDesktop = () => {
			if (!mobile.matches && dialog?.open) dialog.close();
		};
		const closeOnBackdrop = (event: MouseEvent) => {
			if (event.target !== dialog || !dialog) return;
			dialog.close();
		};
		trigger?.addEventListener("click", openBio);
		dialog?.addEventListener("close", restoreScroll);
		dialog?.addEventListener("click", closeOnBackdrop);
		mobile.addEventListener("change", closeOnDesktop);
		let active = true;
		let cleanup = () => {};
		const content = root.querySelector<HTMLElement>(".about-content");
		const copy = root.querySelector<HTMLElement>(".about-copy");
		let fitFrame = 0;
		let lastFitKey = "";

		const fitText = () => {
			fitFrame = 0;
			if (!active || !content || !copy || mobile.matches) return;
			const style = getComputedStyle(content);
			const key = `${content.clientWidth}:${style.fontSize}:${style.lineHeight}`;
			if (key === lastFitKey) return;
			lastFitKey = key;

			// Start with the compact CSS layout on every resize. Only enlarged
			// text/font substitutions need extra height; never reduce font size.
			content.style.removeProperty("--ice-flow-height");
			let height = content.offsetHeight;
			for (let attempt = 0; attempt < 8; attempt++) {
				const textBottom = copy.offsetHeight;
				if (textBottom <= height * 0.75) break;
				height = Math.ceil(height * Math.max(1.08, textBottom / (height * 0.72)));
				content.style.setProperty("--ice-flow-height", `${height}px`);
			}
		};

		const requestTextFit = () => {
			if (active && !fitFrame) fitFrame = requestAnimationFrame(fitText);
		};
		const onFontsLoaded = () => {
			lastFitKey = "";
			requestTextFit();
		};
		const textResizeObserver = new ResizeObserver(requestTextFit);
		if (content) textResizeObserver.observe(content);
		if (copy) textResizeObserver.observe(copy);
		document.fonts.addEventListener("loadingdone", onFontsLoaded);

		const onPageHide = (event: PageTransitionEvent) => {
			if (!shouldTeardownOnPageHide(event.persisted)) return;
			if (dialog?.open) {
				dialog.close();
				restoreScroll();
			}
			trigger?.removeEventListener("click", openBio);
			dialog?.removeEventListener("close", restoreScroll);
			dialog?.removeEventListener("click", closeOnBackdrop);
			mobile.removeEventListener("change", closeOnDesktop);
			active = false;
			cancelAnimationFrame(fitFrame);
			textResizeObserver.disconnect();
			document.fonts.removeEventListener("loadingdone", onFontsLoaded);
			cleanup();
		};

		window.addEventListener("pagehide", onPageHide);

		void document.fonts.ready.then(async () => {
			if (!active) return;
			lastFitKey = "";
			fitText();

			const { gsap } = await loadGsap();
			if (!active) return;

			const panel = root.querySelector<HTMLElement>("[data-ice-panel]");
			const reduce = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const profile = getSpaceMotionProfile({
				reducedMotion: reduce,
				viewportWidth: window.innerWidth,
			});

			const context = gsap.context(() => {
				if (profile.mode === "reduced") {
					gsap.set("[data-about-title], [data-ice-panel]", {
						clearProps: "all",
						autoAlpha: 1,
					});
					gsap.set("[data-ice-shine]", { autoAlpha: 0 });
					return;
				}

				const entrance = gsap.timeline({
					defaults: { ease: "power3.out" },
					scrollTrigger: {
						trigger: root,
						start: "top 82%",
						once: true,
					},
				});

				entrance
					.from("[data-about-title]", {
						y: 30,
						autoAlpha: 0,
						duration: 0.58,
					})
					.from(
						"[data-ice-panel]",
						{
							y: 46,
							rotationX: 8,
							scale: 0.94,
							autoAlpha: 0,
							duration: 0.88,
						},
						"-=0.26",
					)
					.fromTo(
						"[data-ice-shine]",
						{ xPercent: -150, autoAlpha: 0 },
						{
							xPercent: 420,
							autoAlpha: 0.62,
							duration: 1.05,
							ease: "power2.inOut",
						},
						"-=0.32",
					)
					.to("[data-ice-shine]", {
						autoAlpha: 0,
						duration: 0.12,
					});
			}, root);

			const media = gsap.matchMedia();

			if (panel) {
				media.add(
					"(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
					() => {
						gsap.set(panel, {
							transformPerspective: 900,
							transformOrigin: "50% 50%",
						});

						const rotationXTo = gsap.quickTo(panel, "rotationX", {
							duration: 0.45,
							ease: "power3.out",
						});
						const rotationYTo = gsap.quickTo(panel, "rotationY", {
							duration: 0.45,
							ease: "power3.out",
						});
						const xTo = gsap.quickTo(panel, "x", {
							duration: 0.45,
							ease: "power3.out",
						});
						const yTo = gsap.quickTo(panel, "y", {
							duration: 0.45,
							ease: "power3.out",
						});

						const reset = () => {
							rotationXTo(0);
							rotationYTo(0);
							xTo(0);
							yTo(0);
						};

						const onPointerMove = (event: PointerEvent) => {
							const bounds = panel.getBoundingClientRect();
							const normalizedX =
								((event.clientX - bounds.left) / bounds.width) * 2 - 1;
							const normalizedY =
								((event.clientY - bounds.top) / bounds.height) * 2 - 1;

							rotationXTo(-normalizedY * profile.tiltDegrees);
							rotationYTo(normalizedX * profile.tiltDegrees);
							xTo(normalizedX * 8);
							yTo(normalizedY * 8);
						};

						panel.addEventListener("pointermove", onPointerMove);
						panel.addEventListener("pointerleave", reset);

						return () => {
							panel.removeEventListener("pointermove", onPointerMove);
							panel.removeEventListener("pointerleave", reset);
							reset();
						};
					},
					root,
				);
			}

			if (!active) {
				media.revert();
				context.revert();
				return;
			}

			cleanup = () => {
				media.revert();
				context.revert();
			};
		});
	}
</script>
