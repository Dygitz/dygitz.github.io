---
import Email from './email.svelte';
---

<nav class="social-dock" aria-label="Social and contact links">
  <a
    href="https://github.com/Dygitz"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Dominik Ritz on GitHub"
    title="GitHub"
  >
    <span class="social-icon github-icon" aria-hidden="true"></span>
  </a>
  <a
    href="https://www.linkedin.com/in/dominik-ritz/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Dominik Ritz on LinkedIn"
    title="LinkedIn"
  >
    <span class="social-icon linkedin-icon" aria-hidden="true"></span>
  </a>
  <a href="mailto:dom_ritz@icloud.com" aria-label="Email Dominik Ritz" title="Email">
    <span class="email-icon" aria-hidden="true">
      <Email width="24px" height="24px" fill="currentColor" />
    </span>
  </a>
</nav>

<style>
  .social-dock {
    position: fixed;
    left: max(20px, env(safe-area-inset-left, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border: 1px solid rgba(139, 92, 246, 0.5);
    border-top-color: rgba(150, 166, 255, 0.48);
    border-left-color: rgba(98, 220, 255, 0.42);
    border-radius: 20px;
    background: rgba(7, 12, 35, 0.68);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: inset 0 1px 0 rgba(247, 251, 255, 0.04), 0 6px 20px rgba(2, 4, 16, 0.2);
  }

  .social-dock a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--space-text-primary, #f7fbff);
    outline: 2px solid transparent;
    outline-offset: 1px;
    transition: color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .social-dock a:hover,
  .social-dock a:focus-visible {
    color: var(--space-ice-cyan, #62dcff);
    background: rgba(98, 220, 255, 0.08);
    box-shadow: inset 0 0 14px rgba(98, 220, 255, 0.04);
  }

  .social-dock a:focus-visible {
    outline-color: var(--space-ice-cyan, #62dcff);
  }

  .social-icon {
    display: block;
    width: 22px;
    height: 22px;
    background-color: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .github-icon { --icon: url('/icons/social/github.svg'); }
  .linkedin-icon { --icon: url('/icons/social/linkedin.svg'); width: 26px; height: 26px; }
  .email-icon { display: flex; }

  @keyframes dock-enter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .social-dock {
      animation: dock-enter 450ms cubic-bezier(0.22, 1, 0.36, 1) 1.6s backwards;
    }

    /* Start the delay with the hero, after its fonts and animation are ready. */
    :global(html[data-hero-entrance="pending"]) .social-dock {
      animation-play-state: paused;
    }

    /* Keyboard users can reach the links immediately, even during the delay. */
    .social-dock:focus-within {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-dock a { transition: none; }
  }
</style>
