---
import LottieInteractive from "./LottieInteractive.svelte";
import astronautAnimation from "../../astronaut.json";
---

<section
	class="hero-section"
	data-hero-section
	aria-labelledby="hero-name"
>
	<div class="astronaut-flight" data-astronaut-flight>
		<LottieInteractive client:only animationData={astronautAnimation} />
	</div>

	<div class="hero-copy">
		<p class="hero-intro" data-hero-intro>Hi, I'm</p>
		<div class="name-shell">
			<h1 id="hero-name" data-hero-name>Dominik Ritz</h1>
			<span class="name-shine" data-name-shine aria-hidden="true">Dominik Ritz</span>
		</div>
	</div>

	<div class="scroll-cue" data-scroll-cue aria-hidden="true">
		<svg
			viewBox="0 0 24 24"
			width="24"
			height="24"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.7"
				d="m7.5 9.5 4.5 4.5 4.5-4.5"></path>
		</svg>
	</div>
</section>

<style>
	.hero-section {
		isolation: isolate;
		position: relative;
		display: grid;
		min-height: 100vh;
		min-height: 100svh;
		place-items: center;
		overflow: hidden;
		padding: clamp(5rem, 10vh, 8rem) 1.25rem;
		z-index: 3;
	}

	.hero-section::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: url("/illustrations/space/nebula-edges.png");
		background-image: image-set(
			url("/illustrations/space/nebula-edges.avif") type("image/avif"),
			url("/illustrations/space/nebula-edges.png") type("image/png")
		);
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		-webkit-mask-image: linear-gradient(
			to bottom,
			#000 0%,
			#000 72%,
			rgba(0, 0, 0, 0.88) 82%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			#000 0%,
			#000 72%,
			rgba(0, 0, 0, 0.88) 82%,
			transparent 100%
		);
		content: "";
		opacity: 0.34;
		pointer-events: none;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		display: flex;
		width: min(94vw, 80rem);
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.hero-intro {
		margin: 0 0 clamp(0.45rem, 1.5vw, 1rem);
		color: var(--space-text-primary, #f7fbff);
		font-family: "Sora", sans-serif;
		font-size: clamp(1.75rem, 4vw, 3.8rem);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.1;
		text-shadow: 0 0 28px rgba(66, 168, 255, 0.2);
	}

	.name-shell {
		position: relative;
		display: inline-grid;
		max-width: 100%;
		padding-inline: 0.075em;
		place-items: center;
	}

	#hero-name,
	.name-shine {
		grid-area: 1 / 1;
		margin: 0;
		font-family: "Sora", sans-serif;
		font-size: clamp(4rem, 9.2vw, 8.4rem);
		font-kerning: none;
		font-weight: 700;
		letter-spacing: -0.065em;
		line-height: 0.98;
		text-align: center;
		white-space: nowrap;
	}

	#hero-name {
		position: relative;
		z-index: 1;
		background: linear-gradient(
			98deg,
			var(--space-violet, #8b5cf6) 4%,
			var(--space-electric-blue, #42a8ff) 54%,
			var(--space-ice-cyan, #62dcff) 100%
		);
		background-clip: text;
		color: transparent;
		text-rendering: optimizeSpeed;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.name-shine {
		position: relative;
		z-index: 2;
		background: linear-gradient(
			108deg,
			transparent 24%,
			rgba(247, 251, 255, 0.18) 39%,
			rgba(247, 251, 255, 0.92) 50%,
			rgba(98, 220, 255, 0.22) 61%,
			transparent 76%
		) -150% 0 / 48% 100% no-repeat;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		pointer-events: none;
		-webkit-text-fill-color: transparent;
		will-change: background-position;
	}

	.astronaut-flight {
		position: absolute;
		top: clamp(4.8rem, 13vh, 8rem);
		right: clamp(2rem, 10vw, 10rem);
		z-index: 3;
		width: clamp(11.5rem, 23vw, 21rem);
		aspect-ratio: 1;
		pointer-events: none;
		transform-origin: 50% 50%;
		will-change: transform, opacity;
	}

	.scroll-cue {
		position: absolute;
		bottom: clamp(2rem, 7vh, 4.5rem);
		left: 50%;
		z-index: 4;
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border: 1px solid rgba(98, 220, 255, 0.36);
		border-radius: 999px;
		background: rgba(7, 16, 45, 0.58);
		box-shadow:
			0 0 0 5px rgba(66, 168, 255, 0.05),
			0 0 24px rgba(98, 220, 255, 0.22);
		color: var(--space-ice-cyan, #62dcff);
		transform: translateX(-50%);
		will-change: transform, opacity;
	}

	.scroll-cue svg {
		display: block;
		width: 1.45rem;
		height: 1.45rem;
	}

	@media (max-width: 767px) {
		.hero-section {
			padding-inline: 0.75rem;
		}

		.hero-section::before {
			background-position: 48% center;
			opacity: 0.25;
		}

		.hero-copy {
			transform: translateY(2vh);
		}

		.hero-intro {
			font-size: clamp(1.75rem, 8vw, 2.5rem);
		}

		#hero-name,
		.name-shine {
			max-width: 8ch;
			font-size: clamp(3.8rem, 17vw, 5.2rem);
			line-height: 0.94;
			white-space: normal;
		}

		.astronaut-flight {
			top: clamp(4rem, 11vh, 6rem);
			right: -0.75rem;
			width: clamp(10rem, 46vw, 13rem);
		}

		.scroll-cue {
			bottom: max(2.1rem, env(safe-area-inset-bottom));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.name-shine {
			display: none;
		}

		.astronaut-flight,
		.hero-intro,
		#hero-name,
		.scroll-cue {
			will-change: auto;
		}
	}
</style>

<script>
	import { loadGsap } from "../lib/gsapClient";
	import { shouldTeardownOnPageHide } from "../lib/pageLifecycle";
	import { getSpaceMotionProfile } from "../lib/spaceMotion";

	const root = document.querySelector<HTMLElement>("[data-hero-section]");

	if (root) {
		let active = true;
		let cleanup = () => {};

		const onPageHide = (event: PageTransitionEvent) => {
			if (!shouldTeardownOnPageHide(event.persisted)) return;
			active = false;
			cleanup();
		};

		window.addEventListener("pagehide", onPageHide);

		void document.fonts.ready.then(async () => {
			if (!active) return;

			const { gsap, SplitText } = await loadGsap();
			if (!active) return;

			const reduce = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const profile = getSpaceMotionProfile({
				reducedMotion: reduce,
				viewportWidth: window.innerWidth,
			});

			const context = gsap.context(() => {
				if (profile.mode === "reduced") {
					gsap.set(
						"[data-hero-intro], [data-hero-name], [data-scroll-cue], [data-astronaut-flight]",
						{
							clearProps: "all",
							autoAlpha: 1,
						},
					);
					return;
				}

				SplitText.create("[data-hero-name]", {
					type: "chars,lines",
					mask: "lines",
					charsClass: "hero-char",
					linesClass: "hero-line",
					smartWrap: true,
					autoSplit: true,
					onSplit(self) {
						const getCharacterColor = (index: number) =>
							gsap.utils.interpolate(
								"#8b5cf6",
								"#62dcff",
								index / Math.max(self.chars.length - 1, 1),
							);
						gsap.set(self.chars, {
							color: getCharacterColor,
							webkitTextFillColor: getCharacterColor,
						});

						const timeline = gsap.timeline({
							defaults: { ease: "power3.out" },
						});
						timeline
							.from("[data-hero-intro]", {
								y: 24,
								autoAlpha: 0,
								duration: 0.55,
							})
							.from(
								self.chars,
								{
									yPercent: 115,
									autoAlpha: 0,
									duration: 0.72,
									stagger: profile.heroCharacterStagger,
								},
								"-=0.12",
							)
							.fromTo(
								"[data-name-shine]",
								{ backgroundPositionX: "-150%" },
								{
									backgroundPositionX: "250%",
									duration: 0.9,
									ease: "power2.inOut",
								},
								"-=0.28",
							)
							.from(
								"[data-astronaut-flight]",
								{
									xPercent: -60,
									yPercent: 35,
									rotation: -14,
									autoAlpha: 0,
									duration: 1.15,
								},
								"<",
							)
							.from("[data-scroll-cue]", {
								y: -8,
								autoAlpha: 0,
								duration: 0.4,
							});
						return timeline;
					},
				});

				gsap.to("[data-scroll-cue]", {
					y: 9,
					duration: 1.15,
					yoyo: true,
					repeat: -1,
					ease: "sine.inOut",
					delay: 2.2,
				});

				gsap.to("[data-scroll-cue]", {
					autoAlpha: 0,
					scrollTrigger: {
						trigger: root,
						start: "top top",
						end: "20% top",
						scrub: 0.2,
					},
				});
			}, root);

			if (!active) {
				context.revert();
				return;
			}

			cleanup = () => context.revert();
		});
	}
</script>
